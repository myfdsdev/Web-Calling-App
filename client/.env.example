# Base URL of the backend API. Leave as /api to use the Vite dev proxy.
VITE_API_URL=/api

# Vapi PUBLIC key — safe for the browser (used by @vapi-ai/web for web calling).
# NEVER put the Vapi PRIVATE key here.
VITE_VAPI_PUBLIC_KEY=

# Google OAuth client ID — the SAME value as GOOGLE_CLIENT_ID in server/.env.
# It is public by design (it ships in the browser bundle); the client SECRET
# must never be placed here. Leave blank to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=

# Demo video shown in a popup on first sign-in (and from "Watch demo" in the
# sidebar). Overrides the default baked into src/config/demoVideo.js, so staging
# can point at a different cut without a code change. Any YouTube link shape
# works (watch?v= / youtu.be / shorts / embed). Set it to a non-YouTube or
# malformed value and the feature switches itself off rather than embedding a
# broken player — so use the default (leave this unset) unless you mean to change it.
VITE_DEMO_VIDEO_URL=

# Dev/preview only: where Vite proxies /api when VITE_API_URL is left as /api.
VITE_PROXY_TARGET=http://localhost:5000
