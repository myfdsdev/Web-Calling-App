# Base URL of the backend API. Leave as /api to use the Vite dev proxy.
VITE_API_URL=/api

# Vapi PUBLIC key — safe for the browser (used by @vapi-ai/web for web calling).
# NEVER put the Vapi PRIVATE key here.
VITE_VAPI_PUBLIC_KEY=

# Google OAuth client ID — the SAME value as GOOGLE_CLIENT_ID in server/.env.
# It is public by design (it ships in the browser bundle); the client SECRET
# must never be placed here. Leave blank to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
