# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# App identity — surfaced in the store-bridge manifest and in emails so one
# store-side reader can tell each app in the suite apart.
APP_ID=vox
APP_NAME=Vox

# Comma-separated list of allowed browser origins for CORS
CLIENT_URL=http://localhost:5173

# Canonical app origin used to build shareable links (e.g. team invite URLs).
# Falls back to the first CLIENT_URL when unset.
APP_URL=http://localhost:5173

# Public base URL of THIS backend (used to build the Vapi webhook URL)
BACKEND_URL=http://localhost:5000

# ─── Database ─────────────────────────────────────────────
# Leave blank in development to auto-start an in-memory MongoDB.
# In production set a real connection string (MongoDB Atlas, etc.).
MONGODB_URI=

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Encrypts BYOK API keys (users' Vapi/Gemini keys) at rest. Use a long random
# value in production; falls back to JWT_SECRET if unset. Changing it makes
# already-stored keys undecryptable (users must re-enter them).
APP_ENCRYPTION_KEY=change-me-to-another-long-random-string

# Strict BYOK. Default is TRUE: system Vapi/Gemini keys below are IGNORED for
# serving — every workspace must configure its OWN keys. Set to false only if you
# want the system keys used as a shared fallback (e.g. local dev/testing).
REQUIRE_BYOK=true

# ─── Google sign-in ───────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application).
#
#   Authorized JavaScript origins : http://localhost:5173   (+ your prod domain)
#   Authorized redirect URIs      : the GOOGLE_CALLBACK_URL below
#
# The client ID also goes in client/.env as VITE_GOOGLE_CLIENT_ID.
# Leave blank to hide the Google button; email/password keeps working.
GOOGLE_CLIENT_ID=

# Keep the secret on the SERVER only — never copy it into client/.env.
GOOGLE_CLIENT_SECRET=

# Where Google returns the user in the server-side redirect flow.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── Email (Resend) — password-reset & other auth emails ──
# Get a key at https://resend.com (API Keys). Leave blank in dev: reset links are
# printed to the server console instead of emailed. EMAIL_FROM must be an address
# on a domain you've verified in Resend (or onboarding@resend.dev for testing).
RESEND_API_KEY=
EMAIL_FROM=Vox <onboarding@resend.dev>

# ─── Gemini (conversational setup + structured extraction) ─
# BYOK: leave GEMINI_API_KEY blank so every workspace must bring its OWN key
# (users pay Google directly). Set it only if you want a shared system fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Vapi (server-side ONLY — never expose the private key) ─
# BYOK: leave VAPI_PRIVATE_API_KEY blank to force each workspace to use its own
# Vapi account. Set it only to provide a shared system fallback.
VAPI_PRIVATE_API_KEY=
# Public key IS safe to expose to the browser (web calling). Optional here —
# the client normally reads it from VITE_VAPI_PUBLIC_KEY instead.
VAPI_PUBLIC_KEY=
VAPI_BASE_URL=https://api.vapi.ai
# Optional explicit webhook URL; falls back to BACKEND_URL + /api/vapi/webhook
VAPI_WEBHOOK_URL=
# Optional shared secret to verify inbound Vapi webhooks
VAPI_WEBHOOK_SECRET=

# ─── Store bridge (server-to-server provisioning) ─────────
# Shared secret the store presents on POST /api/v1/platform/{provision,suspend,
# reactivate} via the `x-platform-secret` header. UNSET disables the bridge
# entirely (it fails closed) — the public manifest then reports "ready": false.
# Use a long random value, and a DIFFERENT secret per app so one leak costs one app.
PLATFORM_SECRET=

# ─── Transactional email (password reset, welcome, invites) ─
# Provider: 'resend' (HTTP API, recommended) or 'none' to disable sending. With
# 'none', flows still succeed but no mail goes out (reset links are logged in dev).
EMAIL_PROVIDER=none
# Resend API key (https://resend.com) — required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Verified sender. Must be a domain you've verified for sending in Resend.
EMAIL_FROM=Vox <no-reply@your-verified-domain.com>
# A mailbox that can actually RECEIVE replies (verified-for-sending ≠ has an inbox).
EMAIL_REPLY_TO=
